# Build from C:\Users\Justin\src (parent of hypersdk and veil/).
# docker compose -f docker-compose.local.yml uses context ../..
FROM golang:1.23.7-bookworm AS builder

RUN apt-get update && apt-get install -y gcc g++ make && rm -rf /var/lib/apt/lists/*

ENV CGO_ENABLED=1
ENV CGO_CFLAGS="-O2 -D__BLST_PORTABLE__"

WORKDIR /src
COPY hypersdk /src/hypersdk
COPY veil/veilvm /src/veil/veilvm

WORKDIR /src/veil/veilvm
RUN go build -o /build/veilvm ./cmd/veilvm/
RUN go build -o /build/veilvm-keygen ./cmd/veilvm-keygen/
RUN go build -o /build/veilvm-smoke ./cmd/veilvm-smoke/

FROM avaplatform/avalanchego:v1.13.0

COPY --from=builder /build/veilvm /root/.avalanchego/plugins/u9GgvekeunSwK4TPF4jj7xLsW1LKkd1Uv9VQZo2SGfrwkejsK
RUN chmod +x /root/.avalanchego/plugins/u9GgvekeunSwK4TPF4jj7xLsW1LKkd1Uv9VQZo2SGfrwkejsK
COPY --from=builder /build/veilvm-keygen /usr/local/bin/veilvm-keygen
COPY --from=builder /build/veilvm-smoke /usr/local/bin/veilvm-smoke
COPY --from=builder /src/veil/veilvm/genesis.json /root/genesis.json
RUN mkdir -p /root/.avalanchego/zk
COPY --from=builder /src/veil/veilvm/zk-fixture-new/groth16_shielded_ledger_vk.bin /root/.avalanchego/zk/groth16_shielded_ledger_vk.bin
